# ExamIQ Backend Configuration Environment Variables
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Optional OCR binary override for Windows / Linux
# Default on Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Default on Linux: /usr/bin/tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional OpenAI / LLM API key for advanced conversational explanations
# (Baseline uses deterministic TF-IDF n-gram cosine similarity; no paid key required)
# OPENAI_API_KEY=
